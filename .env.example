# Names only. Never commit real values.
# Space-Track: planned for services/feed-poller (not in the repo) on Steven's
# machine. Never set on the SpacetimeDB database and never passed on a command line.
SPACETRACK_USER=
SPACETRACK_PASS=
XAI_API_KEY=            # services/assistant only. Never commit a real key.
XAI_MODEL=              # optional chat model; default grok-4.7 (xAI docs, 2026-10-25). POST https://api.x.ai/v1/chat/completions
ASSISTANT_TOKEN=        # optional SpacetimeDB bearer token; public tables are readable without one
ASSISTANT_PORT=8787     # services/assistant, bound to 127.0.0.1 unless ASSISTANT_HOST is set
VITE_ASSISTANT_URL=     # empty: the globe calls /api/assistant and Vite proxies to ASSISTANT_PORT
ANTHROPIC_API_KEY=
SPACETIMEDB_URI=ws://localhost:3000   # maincloud: wss://maincloud.spacetimedb.com (check)
SPACETIMEDB_MODULE=skyfall-calhacks
VITE_SPACETIMEDB_URI=
VITE_SPACETIMEDB_MODULE=skyfall-calhacks
WORKER_TOKEN=           # identity token for gx10-bridge (see docs/ARCHITECTURE.md)
WORKER_TIER=gpu         # gpu on the GX10, cpu on the fallback laptop
OPERATOR_TOKEN=         # identity token for tools/demo-ctl
COMPUTE_URL=http://localhost:8000
USE_GPU=1               # 0 = CPU fallback with smaller N
SIM_N=100000
