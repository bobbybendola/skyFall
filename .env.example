# Names only. Never commit real values.
# The SpacetimeDB module reads these two as optional database env vars
# (ctx.env). Set them in the shell when publishing a database you control:
#   SPACETRACK_USER='...' SPACETRACK_PASS='...' spacetime publish <db> --server local
# If either is unset, the Space-Track outcome path stays disabled.
SPACETRACK_USER=
SPACETRACK_PASS=
XAI_API_KEY=            # Grok Imagine / Voice / assistant (confirm exact name in xAI docs)
XAI_MODEL=              # chat model for services/assistant (check current name)
ASSISTANT_TOKEN=        # identity token for services/assistant
ANTHROPIC_API_KEY=
SPACETIMEDB_URI=ws://localhost:3000   # maincloud: wss://maincloud.spacetimedb.com (check)
SPACETIMEDB_MODULE=skyfall-calhacks
VITE_SPACETIMEDB_URI=
VITE_SPACETIMEDB_MODULE=skyfall-calhacks
WORKER_TOKEN=           # identity token for gx10-bridge (see docs/ARCHITECTURE.md)
WORKER_TIER=gpu         # gpu on the GX10, cpu on the fallback laptop
OPERATOR_TOKEN=         # identity token for tools/demo-ctl
COMPUTE_URL=http://localhost:8000
USE_GPU=1               # 0 = CPU fallback with smaller N
SIM_N=100000
